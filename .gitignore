# ============================================================ 环境与密钥
# .env 里可能放着数据源密钥、代理密码、SMTP 口令 —— 一旦提交就不可撤回。
# 只保留 .env.example 作为模板。
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# ============================================================ Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ============================================================ 虚拟环境
.venv/
venv/
env/
ENV/

# ============================================================ 数据与日志
# SQLite 主库与 WAL/SHM 伴生文件含真实业务数据，不进版本库。
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# data/ 下是运行期产物：数据库、探针日志、临时测试库、报告
data/
logs/
backups/
tmp/

# ============================================================ 测试缓存
.pytest_cache/
.coverage
coverage.xml

# ============================================================ 前端构建产物
node_modules/
frontend/dist/
frontend/build/

# ============================================================ IDE 与系统
.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini

# ============================================================ 本地助手工作区
# 里面有项目记忆（含个人信息与本机路径），与代码无关，不提交。
.workbuddy/
