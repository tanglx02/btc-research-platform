# ============================================================================
# BTC 全市场智能研究平台 —— 环境变量示例
# 用法：复制为 .env 后按需要修改（cp .env.example .env）
# 说明：本文件只提交占位值，**禁止**把真实密钥提交进代码库。
# ============================================================================

# ---------------- 基础 ----------------
APP_NAME=BTC Intelligence Platform
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8787
TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
LOG_DIR=logs

# 生产环境必须修改为高强度随机串（可用 openssl rand -hex 32 生成）
# 生成后请勿提交到版本库
SECRET_KEY=change-me-in-production-please-use-long-random-string
ADMIN_TOKEN=admin-change-me

# ---------------- 存储 ----------------
# SQLite（零依赖，开箱即用，Windows/Linux 均可）
DATABASE_URL=sqlite+aiosqlite:///data/btc.db
# PostgreSQL 示例（生产推荐，可叠加 TimescaleDB）
# DATABASE_URL=postgresql+psycopg://btc:strong_password@127.0.0.1:5432/btc
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
DATA_DIR=data
BACKUP_DIR=backups
RAW_RETENTION_DAYS=3650

# ---------------- 缓存 ----------------
# 留空则使用进程内内存缓存；配置后自动切到 Redis
REDIS_URL=
CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=5000

# ---------------- 网络策略（国内网络环境常用）----------------
DEFAULT_TIMEOUT_CONNECT=4.0
DEFAULT_TIMEOUT_READ=10.0
DEFAULT_RETRIES=2
DEFAULT_BACKOFF_BASE=0.6
DEFAULT_BACKOFF_MAX=8.0
HTTP_PROXY=
HTTPS_PROXY=
SOCKS_PROXY=
DNS_SERVERS=
MAX_CONNECTIONS_PER_PROVIDER=8
RATE_LIMIT_DEFAULT_QPS=2.0

# ---------------- 故障切换 / 健康检查 ----------------
FAILURE_THRESHOLD=3
DEGRADED_LATENCY_MS=2500
SLOW_LATENCY_MS=1500
RECOVERY_SUCCESS_STREAK=3
RECOVERY_COOLDOWN_SECONDS=180
STALE_AFTER_SECONDS=180
CROSS_VALIDATION_TOLERANCE_PCT=0.35
CROSS_VALIDATION_MIN_SOURCES=2

# ---------------- 采集调度（秒）----------------
SCHEDULER_ENABLED=true
JOB_MARKET_TICK_SECONDS=30
JOB_MARKET_1H_SECONDS=300
JOB_MARKET_1D_SECONDS=1800
JOB_ONCHAIN_SECONDS=3600
JOB_SENTIMENT_SECONDS=3600
JOB_MACRO_SECONDS=21600
JOB_ETF_SECONDS=21600
JOB_RETENTION_SECONDS=86400
JOB_DERIVATIVES_SECONDS=300
JOB_QUALITY_SECONDS=3600
JOB_HEALTH_SECONDS=120
BACKFILL_START_DATE=2013-01-01
BACKFILL_BATCH_DAYS=500

# ---------------- 智能监测 / 条件预警 ----------------
# 关闭后不再评估任何规则，也不会发邮件（页面仍可查看历史）
ALERTS_ENABLED=true
# 预警引擎评估周期（秒）。所有到期规则**一次取数统一评估**，不给每条规则单独请求数据源
JOB_ALERT_ENGINE_SECONDS=60
# 邮件补发轮询周期（秒）：上次没发成功的提醒会在这里被重试
JOB_ALERT_RETRY_SECONDS=300
# 摘要邮件检查周期（秒）
JOB_ALERT_DIGEST_SECONDS=900
# 单个评估周期最多处理多少条规则（防止规则过多拖垮一次评估）
ALERT_MAX_RULES_PER_CYCLE=500
# 每日摘要发送时间（小时，0-23，按服务器本地时间）
ALERT_DIGEST_DAILY_HOUR=9
# 每周摘要：星期几（0=周一 … 6=周日）与小时
ALERT_DIGEST_WEEKLY_WEEKDAY=0
ALERT_DIGEST_WEEKLY_HOUR=9

# ---------------- SMTP 邮件（提醒发送通道）----------------
# 也可以在网站「邮件设置」页面里配置，页面配置优先于此处
SMTP_HOST=
SMTP_PORT=465
# 加密方式：ssl（465）/ starttls（587）/ none（25，不推荐）
SMTP_ENCRYPTION=ssl
SMTP_USER=
# 注意：授权码/密码。用国内邮箱一般填「授权码」而不是登录密码
SMTP_PASSWORD=
# 发件人地址；留空则默认用 SMTP_USER
SMTP_SENDER=
# 发件人显示名
SMTP_SENDER_NAME=BTC 智能监测
# 默认收件人（多个用英文逗号分隔）。规则里可以单独指定收件人
SMTP_TO=
# 单次发信超时（秒）
SMTP_TIMEOUT_SECONDS=20
# 邮件里链接回网站用的地址（如 http://192.168.1.10:8000）
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ---------------- 可选第三方数据源 Key ----------------
# 未配置时对应 Provider 状态为 NOT_CONFIGURED，系统**不会**用假数据顶替
GLASSNODE_API_KEY=
COINGLASS_API_KEY=
FRED_API_KEY=
CRYPTOQUANT_API_KEY=

# ---------------- AI 解释助手（可选）----------------
AI_ASSISTANT_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------------- Provider 主备顺序覆盖（JSON，可选）----------------
# 例：{"market_price":{"primary":"binance_vision","disabled":["xxx"],"order":["binance_vision","coingecko"]}}
PROVIDER_OVERRIDES={}

# ---------------- CORS ----------------
# 开发环境可用 *；生产环境请写显式来源，逗号分隔
CORS_ORIGINS=*
